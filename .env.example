# VNPost Deep Agent Configuration
DATA_DIR=./data

# LLM Configuration (OpenAI-compatible)
LLM_BASE_URL=http://your-llm-server:8080/v1
LLM_API_KEY=replace-with-llm-key
LLM_MODEL=your-tool-calling-model
SUBAGENT_MODEL=your-tool-calling-model
LLM_TIMEOUT=60
REQUEST_TIMEOUT=120
MAX_REQUESTS=4
MAX_SUBAGENTS=3
MAX_TASKS=8
MAX_AGENT_STEPS=35
# Deep is bounded to one short planning iteration; timeout returns Tier 1 text.
DEEP_TIMEOUT=35
DEEP_MAX_AGENT_STEPS=12

# Router: fast/retrieval-first is the default. The LLM router is an opt-in experiment.
ROUTER_ENABLED=true
SEMANTIC_ROUTER_ENABLED=true
LLM_ROUTER_ENABLED=false
# Leave empty to use SUBAGENT_MODEL, then LLM_MODEL.
ROUTER_MODEL=
ROUTER_TIMEOUT=8
SEMANTIC_ROUTER_MIN_CONFIDENCE=0.72
ROUTER_MAX_CHARACTERS=1200

# Embedding Configuration (Vietnamese Bi-Encoder / HuggingFace)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=dummy
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_REVISION=v1
LOCAL_EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=256
# Structural units (heading, paragraph, table row) are kept whole; this is only the fallback split limit.
# BKAI accepts at most 256 tokens.
CHUNK_SIZE=256
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
# Tier 1 escalates only if retrieval returns fewer sources than this.
FAST_MIN_SOURCES=1
# Optional: raw RRF score threshold; keep 0 until tuned against a labelled set.
FAST_MIN_RETRIEVAL_SCORE=0
MIN_SIMILARITY=0.35
# Cross-encoder reranks the RRF candidate pool before evidence reaches the LLM.
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=auto
RERANKER_CANDIDATE_K=15
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=12
ALLOW_HASH=false
HF_HUB_OFFLINE=true

# TTS Configuration (ZeroTTS VNPost)
TTS_ENABLED=true
TTS_BASE_URL=https://ai.vnpost.vn/zero-tts
TTS_API_KEY=
TTS_VOICE=maichi
TTS_MODE=standard
TTS_TIMEOUT=90
MAX_PARALLEL_TTS=2
MAX_TTS_CHARS=5000
MAX_AUDIO_BYTES=25000000
AUDIO_TTL=3600

# Security & pilot limits
API_KEYS_JSON={"replace-with-a-16-char-random-key":"vnpost"}
# Required only for POST /api/documents/verified. Keep it separate from chat API keys.
TRUSTED_INGEST_KEY=replace-with-a-second-long-random-secret
# Do not widen this list unless the product owner explicitly approves another source.
OFFICIAL_SOURCE_DOMAINS=vietnampost.vn
ALLOW_ANONYMOUS=true
MAX_UPLOAD_BYTES=15000000
MAX_DOCX_BYTES=60000000
MAX_DOCUMENTS=200
MAX_CORPUS_CHARS=10000000
MAX_HISTORY=16
