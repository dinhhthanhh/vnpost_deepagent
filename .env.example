# ==============================================================================
# VNPost Deep Agent Configuration (TEMPLATE / EXAMPLE)
# ==============================================================================
# Tệp mẫu cấu hình hệ thống. Sao chép tệp này thành .env và điền các khóa API thực tế.
# Lưu ý: Không commit tệp .env chứa khóa bí mật lên Git repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH HỆ THỐNG VÀ DỮ LIỆU CHUNG
# ------------------------------------------------------------------------------
# Đặt DEMO_MODE=false trong production để bắt buộc dùng API Key thật
DEMO_MODE=false
DATA_DIR=./data

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH MÔ HÌNH NGÔN NGỮ CHÍNH (LLM & SUBAGENTS)
# ------------------------------------------------------------------------------
# Hỗ trợ OpenAI API hoặc các máy chủ tương thích (Gemini OpenAI endpoint, vLLM, Ollama)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gemini-2.5-flash
SUBAGENT_MODEL=gemini-2.5-flash
LLM_SUPPORTS_VISION=true
LLM_THINKING=false
LLM_TIMEOUT=60
REQUEST_TIMEOUT=120
MAX_REQUESTS=4
MAX_SUBAGENTS=3
MAX_TASKS=8
MAX_AGENT_STEPS=35

# ------------------------------------------------------------------------------
# 3. CƠ SỞ DỮ LIỆU & CHECKPOINTER (MEMORY | SQLITE | POSTGRES)
# ------------------------------------------------------------------------------
CHECKPOINTER_ENABLED=true
CHECKPOINTER_TYPE=memory
POSTGRES_URL=postgresql://vnpost_user:vnpost_password@localhost:5432/vnpost_db
POSTGRES_MIN_CONNECTIONS=1
POSTGRES_MAX_CONNECTIONS=10

# ------------------------------------------------------------------------------
# 4. BỘ ĐỊNH TUYẾN THÍCH ỨNG & FAST RAG (ROUTER)
# ------------------------------------------------------------------------------
ROUTER_ENABLED=true
SEMANTIC_ROUTER_ENABLED=true
LLM_ROUTER_ENABLED=false
ROUTER_MODEL=
ROUTER_TIMEOUT=8
SEMANTIC_ROUTER_MIN_CONFIDENCE=0.72
ROUTER_MAX_CHARACTERS=1200

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH NHÚNG VECTOR & HYBRID RETRIEVAL (EMBEDDING)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
ALLOW_HASH=true
EMBEDDING_BASE_URL=https://your-embedding-server:8000/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_REVISION=v2_bge_m3
LOCAL_EMBEDDING_MODEL=your-local-embedding-model
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
FAST_MIN_SOURCES=1
FAST_MIN_RETRIEVAL_SCORE=0
MIN_SIMILARITY=0.35

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH TÁI XẾP HẠNG (CROSS-ENCODER RERANKER)
# ------------------------------------------------------------------------------
RERANKER_ENABLED=true
RERANKER_PROVIDER=api
RERANKER_BASE_URL=https://your-reranker-server:8000/rerank
RERANKER_API_KEY=your-reranker-api-key
RERANKER_MODEL=your-reranker-model
RERANKER_CANDIDATE_K=15

# ------------------------------------------------------------------------------
# 7. PHÂN HỆ GIỌNG NÓI (ZEROTTS & STT)
# ------------------------------------------------------------------------------
TTS_ENABLED=true
TTS_BASE_URL=https://your-tts-server/zero-tts
TTS_API_KEY=your-tts-api-key
TTS_VOICE=maichi
TTS_MODE=standard
TTS_TIMEOUT=90
MAX_PARALLEL_TTS=2
MAX_TTS_CHARS=5000
MAX_AUDIO_BYTES=25000000
AUDIO_TTL=3600

# ------------------------------------------------------------------------------
# 8. BẢO MẬT, XÁC THỰC TENANT & GIỚI HẠN KHO TÀI LIỆU
# ------------------------------------------------------------------------------
API_KEYS_JSON={"your-secret-api-key-here":"vnpost"}
TRUSTED_INGEST_KEY=your-trusted-ingest-secret-here
OFFICIAL_SOURCE_DOMAINS=vietnampost.vn
# Đặt ALLOW_ANONYMOUS=false trong production. Chỉ đặt true khi thử nghiệm cục bộ.
ALLOW_ANONYMOUS=false
MAX_UPLOAD_BYTES=15000000
MAX_DOCX_BYTES=60000000
MAX_DOCUMENTS=200
MAX_CORPUS_CHARS=10000000
MAX_HISTORY=16
HF_TOKEN=your-huggingface-token-if-needed
HF_HUB_OFFLINE=true

# ------------------------------------------------------------------------------
# 9. GIỚI HẠN TẦN SUẤT GỌI API (RATE LIMITING - REQUESTS PER MINUTE)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_RPM=60
RATE_LIMIT_VOICE_RPM=40
RATE_LIMIT_GENERAL_RPM=120
