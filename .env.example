# VNPost Deep Agent Configuration
# Set DEMO_MODE=false in production to enforce real keys, non-empty API_KEYS_JSON, and disallow hash embeddings.
DEMO_MODE=false
DATA_DIR=./data

# LLM Configuration (OpenAI-compatible / Google Gemini OpenAI endpoint)
# Ví dụ: https://generativelanguage.googleapis.com/v1beta/openai hoặc server OpenAI/vLLM riêng
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=your-gemini-or-openai-api-key
LLM_MODEL=gemini-2.5-flash
SUBAGENT_MODEL=gemini-2.5-flash
LLM_SUPPORTS_VISION=true
# Set LLM_THINKING=false for models like Qwen3/Qwen3.5 to prevent slow reasoning tokens on straightforward answers
LLM_THINKING=false
LLM_TIMEOUT=60
REQUEST_TIMEOUT=120
MAX_REQUESTS=4
MAX_SUBAGENTS=3
MAX_TASKS=8
MAX_AGENT_STEPS=35

# Checkpointer & Database Configuration (memory | sqlite | postgres)
CHECKPOINTER_ENABLED=true
CHECKPOINTER_TYPE=memory
# PostgreSQL Connection URL (dùng cho Checkpointer bền vững, lưu trữ Đơn hàng & Khiếu nại HITL)
POSTGRES_URL=postgresql://vnpost_user:vnpost_password@localhost:5432/vnpost_db
POSTGRES_MIN_CONNECTIONS=1
POSTGRES_MAX_CONNECTIONS=10

# Router & Fast RAG
ROUTER_ENABLED=true
SEMANTIC_ROUTER_ENABLED=true
LLM_ROUTER_ENABLED=false
# Leave empty to use SUBAGENT_MODEL, then LLM_MODEL.
ROUTER_MODEL=
ROUTER_TIMEOUT=8
SEMANTIC_ROUTER_MIN_CONFIDENCE=0.72
ROUTER_MAX_CHARACTERS=1200

# Embedding Configuration (vLLM BGE-M3 REST API - 1024 dimensions)
EMBEDDING_PROVIDER=openai
ALLOW_HASH=true
EMBEDDING_BASE_URL=https://your-embedding-server:8000/v1
EMBEDDING_API_KEY=dummy
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=v2_bge_m3
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
FAST_MIN_SOURCES=1
FAST_MIN_RETRIEVAL_SCORE=0
MIN_SIMILARITY=0.35

# Reranker Configuration (vLLM Qwen3-Reranker-8B REST API)
RERANKER_ENABLED=true
RERANKER_PROVIDER=api
RERANKER_BASE_URL=https://your-reranker-server:8000/rerank
RERANKER_API_KEY=
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
RERANKER_CANDIDATE_K=15

# TTS Configuration (ZeroTTS)
TTS_ENABLED=true
TTS_BASE_URL=https://your-tts-server/zero-tts
TTS_API_KEY=
TTS_VOICE=maichi
TTS_MODE=standard
TTS_TIMEOUT=90
MAX_PARALLEL_TTS=2
MAX_TTS_CHARS=5000
MAX_AUDIO_BYTES=25000000
AUDIO_TTL=3600

# Security & pilot limits
API_KEYS_JSON={"replace-with-a-16-char-random-key":"vnpost"}
TRUSTED_INGEST_KEY=replace-with-a-second-long-random-secret
OFFICIAL_SOURCE_DOMAINS=vietnampost.vn
ALLOW_ANONYMOUS=true
MAX_UPLOAD_BYTES=15000000
MAX_DOCX_BYTES=60000000
MAX_DOCUMENTS=200
MAX_CORPUS_CHARS=10000000
MAX_HISTORY=16
HF_TOKEN=
HF_HUB_OFFLINE=true
