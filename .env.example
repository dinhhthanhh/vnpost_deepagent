# VNPost Deep Agent Configuration
DATA_DIR=./data

# LLM Configuration (OpenAI-compatible)
LLM_BASE_URL=http://171.226.10.154:8080/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=Qwen/Qwen3.5-35B-A3B-GPTQ-Int4
SUBAGENT_MODEL=Qwen/Qwen3.5-35B-A3B-GPTQ-Int4
LLM_TIMEOUT=60
REQUEST_TIMEOUT=120
MAX_REQUESTS=4
MAX_SUBAGENTS=3
MAX_TASKS=8
MAX_AGENT_STEPS=35

# Embedding Configuration (PhoBERT / Vietnamese Bi-Encoder or HuggingFace)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=dummy
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_REVISION=v1
LOCAL_EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
MIN_SIMILARITY=0.35
ALLOW_HASH=false

# TTS Configuration (ZeroTTS VNPost)
TTS_ENABLED=true
TTS_BASE_URL=https://ai.vnpost.vn/zero-tts
TTS_API_KEY=
TTS_VOICE=maichi
TTS_MODE=standard
TTS_TIMEOUT=90
MAX_PARALLEL_TTS=2
MAX_TTS_CHARS=5000
MAX_AUDIO_BYTES=25000000
AUDIO_TTL=3600

# Security & Limits
API_KEYS_JSON={"replace-with-a-16-char-random-key":"vnpost"}
ALLOW_ANONYMOUS=true
MAX_UPLOAD_BYTES=15000000
MAX_DOCX_BYTES=60000000
MAX_DOCUMENTS=200
MAX_CORPUS_CHARS=10000000
MAX_HISTORY=16
